cabal-version: 3.4

name:          ingway
version:       0.1.0.0

synopsis:      The Ingway language compiler
description:   The Ingway language is a functional programming language.

license:       GPL-3.0-or-later
license-file:  LICENSE
author:        Sebastian Tee
maintainer:    SebTee

homepage:      https://github.com/SebTee/ingway
bug-reports:   https://github.com/SebTee/ingway/issues

category:      Language
build-type:    Simple

extra-doc-files:
    CHANGELOG.md
    README.md

source-repository head
    type:      git
    location:  https://github.com/SebTee/ingway.git

common warnings
    ghc-options: -Wall

common threaded
    ghc-options: -threaded -rtsopts -with-rtsopts=-N

library
    import:           warnings
    exposed-modules:
        Text.Ingway.Parser
    hs-source-dirs:   src
    default-language: Haskell2010
    build-depends:    
        base >=4.17.0.0,
        parsec ==3.1.*

executable ingway
    import:
      warnings,
      threaded
    main-is:          Main.hs
    hs-source-dirs:   app
    default-language: Haskell2010
    build-depends:
        base >=4.17.0.0,
        ingway

test-suite ingway-test
    import:
      warnings,
      threaded
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    other-modules:
        ParserSpec
        ParserSpec.HelperFunctions
        ParserSpec.Literals
        ParserSpec.Expressions
    hs-source-dirs:   test
    default-language: Haskell2010
    build-depends:
        base >=4.17.0.0,
        parsec ==3.1.*,
        hspec ==2.11.*,
        ingway
